#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# The fingerprint of this certificate is what Cloudflare compares. It must
# never change by accident, so the key pair is only ever created when neither
# file exists, and never when just one of them is missing.
KEYS=/config/keys
CERT="${KEYS}/cert.crt"
KEY="${KEYS}/cert.key"
CN="managed-network.internal"
# Where versions before 1.0.0 kept the pair (a volume mounted at /certs).
OLD=/certs

echo "cf-managed-network-endpoint ${CFMNE_VERSION:-dev} starting"

# Stop with a clear message when the key pair can't be created or read. Without
# this the step would go on and report success without a key pair.
die() {
    echo "ERROR: $*" >&2
    exit 1
}

# nginx logs to stdout/stderr (the container log), not to files in /config
# that nothing rotates. The base image's nginx.conf still names the two files,
# so they become links to the container's streams. Replaces the files of
# earlier versions, which can be deleted.
LOGS=/config/log/nginx
mkdir -p "${LOGS}" || die "could not create ${LOGS}"
ln -sfn /dev/stdout "${LOGS}/access.log" || die "could not link ${LOGS}/access.log to stdout"
ln -sfn /dev/stderr "${LOGS}/error.log" || die "could not link ${LOGS}/error.log to stderr"

mkdir -p "${KEYS}" || die "could not create ${KEYS}"

if [[ -f ${CERT} && -f ${KEY} ]]; then
    echo "Using the existing certificate: ${CERT}"
elif [[ -f ${CERT} || -f ${KEY} ]]; then
    echo "ERROR: ${KEYS} holds only one of cert.crt/cert.key." >&2
    echo "Check the volume or restore it from backup. No new certificate is" >&2
    echo "created on purpose: it would change the fingerprint." >&2
    exit 1
elif [[ -f ${OLD}/cert.pem && -f ${OLD}/key.pem ]]; then
    echo "Taking over the certificate from ${OLD} (same fingerprint as before)"
    cp "${OLD}/cert.pem" "${CERT}" || die "could not copy ${OLD}/cert.pem to ${CERT}"
    cp "${OLD}/key.pem" "${KEY}" || die "could not copy ${OLD}/key.pem to ${KEY}"
elif [[ -f ${OLD}/cert.pem || -f ${OLD}/key.pem ]]; then
    echo "ERROR: ${OLD} holds only one of cert.pem/key.pem." >&2
    echo "Check the volume or restore it from backup. No new certificate is" >&2
    echo "created on purpose: it would change the fingerprint." >&2
    exit 1
else
    echo "No certificate found: creating one (CN=${CN}, RSA 2048, 3650 days)"
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -subj "/CN=${CN}" -keyout "${KEY}" -out "${CERT}" \
        || die "could not create the key pair in ${KEYS}"
fi

# The pair must exist now, however it got here (a failed cp or openssl may
# leave half of it or nothing).
[[ -s ${CERT} && -s ${KEY} ]] || die "could not create the key pair in ${KEYS}: cert.crt or cert.key is missing or empty"

chmod 600 "${KEY}" || die "could not set the mode of ${KEY}"
chmod 644 "${CERT}" || die "could not set the mode of ${CERT}"
lsiown -R abc:abc "${KEYS}" || die "could not change the owner of ${KEYS}"

FP_COLON=$(openssl x509 -in "${CERT}" -noout -fingerprint -sha256 | cut -d= -f2)
[[ -n ${FP_COLON} ]] || die "could not read the fingerprint of ${CERT}"
FP_PLAIN=$(printf '%s' "${FP_COLON}" | tr -d ':' | tr 'A-F' 'a-f')

echo "=================================================================="
echo " SHA-256 fingerprint of the TLS certificate"
echo ""
echo "   ${FP_COLON}"
echo ""
echo " For Cloudflare Zero Trust (managed networks, without colons):"
echo ""
echo "   ${FP_PLAIN}"
echo "=================================================================="

# A host without IPv6 can't open the [::] socket and nginx would not start.
SITE=/config/nginx/site-confs/default.conf
if [[ ! -e /proc/net/if_inet6 && -f ${SITE} ]] && grep -q 'listen \[::\]' "${SITE}"; then
    echo "No IPv6 on this host: removing the [::] listener from ${SITE}"
    sed -i '/listen \[::\]/d' "${SITE}"
fi
